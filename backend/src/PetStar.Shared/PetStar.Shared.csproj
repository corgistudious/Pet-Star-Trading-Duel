<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the Unity package source in /shared-contracts so backend and client share one rules implementation. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>PetStar</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../shared-contracts/Runtime/**/*.cs" />
  </ItemGroup>
</Project>
