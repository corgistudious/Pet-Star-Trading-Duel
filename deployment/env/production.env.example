# Copy to deployment/env/production.env and fill in. NEVER commit the real file.
PETSTAR_ENV=production
PETSTAR_VERSION=0.1.0
ASPNETCORE_ENVIRONMENT=Production
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
JWT_SIGNING_KEY=generate-with-openssl-rand-base64-48
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
ADMIN_ALLOW_CIDR=203.0.113.10/32
OWNER_EMAIL=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
GOOGLE_PLAY_PACKAGE=com.petstar.tradingduel
GOOGLE_PLAY_SA_PATH=/run/secrets/petstar/google-play-sa.json
SEED_SYNC_PACK_TYPES=false
BACKUP_RETENTION_DAYS=14
HTTP_PORT=80
HTTPS_PORT=443
