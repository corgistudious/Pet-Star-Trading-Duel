# Copy to /opt/petstar/petstar.env ON THE VPS, then: chmod 600 /opt/petstar/petstar.env
# Generate secrets on the VPS (never paste them into chat, issues or commits):
#   openssl rand -base64 36   (POSTGRES_PASSWORD, REDIS_PASSWORD)
#   openssl rand -base64 48   (JWT_SIGNING_KEY)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SIGNING_KEY=

# Browser origin of the web client (CORS + WebSocket Origin allowlist). Exact origin, no trailing slash.
WEB_ORIGIN=https://petstar.pages.dev
# Optional second origin (e.g. a custom domain later)
WEB_ORIGIN_2=

# Existing account that is granted "owner" at the next API start (register first, then set this and re-run deploy.sh)
OWNER_EMAIL=

# Loopback port for the API (must be free on the VPS; preflight.sh checks it)
API_HOST_PORT=18080

# Resource limits (tune to the VPS size; keep headroom for the other projects)
API_CPUS=1.5
API_MEM=768m
PG_CPUS=1.0
PG_MEM=1g
DB_POOL_SIZE=60

# Backups on the host (outside Docker volumes so they survive a volume mistake)
BACKUP_HOST_DIR=/opt/petstar/backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=21600

# Image to run. Leave the default to build on the VPS, or use the image published by the deploy workflow:
# PETSTAR_API_IMAGE=ghcr.io/<owner>/pet-star-trading-duel/petstar-api:<git-sha>
PETSTAR_API_IMAGE=petstar-api:local

# Only when using the Cloudflare Tunnel ingress (docker compose --profile tunnel ...)
CLOUDFLARE_TUNNEL_TOKEN=

# Web Push (optional). Generate ON THE VPS after the image is built:
#   docker compose -p petstar-prod -f deployment/vps/docker-compose.yml --env-file /opt/petstar/petstar.env run --rm --no-deps api generate-vapid
# and paste both lines here. Keep the private key secret; rotating it invalidates all existing subscriptions.
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
# Contact for push services (mailto: or https: URL you control)
WEBPUSH_SUBJECT=

# Optional e-mail (verification / password reset). Leave SMTP_HOST empty and e-mails are NOT sent (logged only).
# STARTTLS on port 587 is required (implicit TLS on 465 is not supported). SMTP_FROM must be allowed by the provider.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_FROM=
SEED_SYNC_PACK_TYPES=false
