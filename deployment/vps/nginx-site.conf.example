# OPTION B ingress: ONE new site file for the host's existing Nginx. It only adds a server block for the
# Pet Star API hostname; no existing site, upstream or global setting is edited.
#   sudo cp nginx-site.conf.example /etc/nginx/sites-available/petstar-api.conf
#   sudo sed -i 's/api.example.com/<your-api-hostname>/g' /etc/nginx/sites-available/petstar-api.conf
#   sudo ln -s /etc/nginx/sites-available/petstar-api.conf /etc/nginx/sites-enabled/petstar-api.conf
#   sudo nginx -t && sudo systemctl reload nginx        # reload is graceful; abort if nginx -t fails
#   sudo certbot certonly --webroot -w /var/www/petstar-acme -d <your-api-hostname>
#   (then uncomment the 443 block below, nginx -t, reload)

map $http_upgrade $petstar_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name api.example.com;

    location /.well-known/acme-challenge/ { root /var/www/petstar-acme; }
    location / { return 301 https://$host$request_uri; }
}

